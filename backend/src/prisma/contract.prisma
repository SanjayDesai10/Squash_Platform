// use prisma-8

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  // null for accounts created with Google sign-in (no password yet)
  passwordHash  String?
  // email/password sign-ups must confirm a 6-digit code first
  emailVerified Boolean  @default(false)
  // profile photo from Google, when available
  image         String?
  role          String   @default("user")
  tokenVersion  Int      @default(0)
  createdAt     DateTime @default(now())

  bookings     Booking[]
}

model Court {
  id           Int        @id @default(autoincrement())
  name         String
  type         String?
  description  String?
  features     String[]
  pricePerHour Int
  available    Boolean    @default(true)
  isActive     Boolean    @default(true)
  image        String?
  color        String

  timeslots    Timeslot[]
  bookings     Booking[]
}

model Timeslot {
  id        Int      @id @default(autoincrement())
  courtId   Int
  date      String
  startTime String
  endTime   String
  available Boolean  @default(true)
  isActive  Boolean  @default(true)

  court Court @relation(fields: [courtId], references: [id])

  @@unique([courtId, date, startTime])
}

model Booking {
  id        String   @id
  courtId   Int
  date      String
  startTime String
  endTime   String
  price     Int
  status    String   @default("confirmed")
  createdAt DateTime @default(now())
  userId    Int?

  court Court  @relation(fields: [courtId], references: [id])
  user  User?  @relation(fields: [userId], references: [id])

  @@index([courtId, date, startTime], map: "booking_confirmed_slot_unique", where: "(status = 'confirmed'::text)", unique: true)
}

// ─── Better Auth tables ─────────────────────────────────────────
// Used only by Better Auth (Google OAuth + email OTP codes). Our app
// accounts live in `user`; after Google sign-in the backend links/creates
// a `user` by email and issues our own JWT. Table names are prefixed so
// they never clash with the app's tables.

model AuthUser {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now())

  sessions      AuthSession[]
  accounts      AuthAccount[]

  @@map("auth_user")
}

model AuthSession {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  ipAddress String?
  userAgent String?
  userId    String

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_session")
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now())

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_account")
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  @@index([identifier])
  @@map("auth_verification")
}
