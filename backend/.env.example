# Copy this file to `.env` and replace the placeholders with real values.
# Never commit `.env`.

# Connection string for PostgreSQL. Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Secret used to sign JWTs. Required; must be at least 32 characters
# in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-long-random-secret"

# HTTP port (default 3000).
PORT=3000

# Comma-separated browser origins allowed to call the API cross-origin.
# Not needed in development (the Vite dev server proxies /api) or when
# the frontend is served from the same origin.
CORS_ORIGIN=""

# Set to "true" when running behind a reverse proxy / load balancer.
TRUST_PROXY="false"

# ─── Google sign-in + email codes (Better Auth) ───────────────────

# Public URL of the website (the Vite dev server in development).
# Google redirects users back here, and it's the only origin Better
# Auth accepts requests from.
FRONTEND_URL="http://localhost:5173"

# Secret Better Auth uses to sign its own cookies. Required in
# production (32+ characters); separate from JWT_SECRET. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=""

# Optional: where Better Auth is reached from the browser. Defaults to
# FRONTEND_URL, since /api is proxied (dev) or served (prod) from there.
# BETTER_AUTH_URL="http://localhost:5173"

# Google OAuth client (Google Cloud Console → APIs & Services →
# Credentials → OAuth client ID → Web application). Leave empty to hide
# the "Continue with Google" button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (https://resend.com) for email verification codes. Without a
# key, codes are printed to the backend console in development.
RESEND_API_KEY=""
# Sender. Resend's test address only delivers to the email your Resend
# account was created with; switch to your own verified domain later,
# e.g. "The Ball Room <no-reply@theballroom.in>".
EMAIL_FROM="The Ball Room <onboarding@resend.dev>"
