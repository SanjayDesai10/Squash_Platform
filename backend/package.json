{
  "name": "server",
  "version": "1.0.0",
  "description": "The Ball Room court-booking API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "NODE_ENV=production node dist/index.js",
    "typecheck": "tsc --noEmit",
    "make-admin": "tsx src/cli/makeAdmin.ts",
    "contract:emit": "prisma contract emit",
    "db:migrate": "prisma db migrate",
    "db:verify": "prisma db verify",
    "seed": "tsx src/cli/seed.ts",
    "postinstall": "prisma skills sync || exit 0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/orm-postgres": "^8.0.0-rc.11",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "temporal-polyfill": "^1.0.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.1",
    "prisma": "^8.0.0-rc.15",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
