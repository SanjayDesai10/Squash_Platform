# Base URL of the backend API. Leave empty in development (Vite proxies
# /api to http://localhost:3000) or when the API is served from the
# same origin as the frontend.
VITE_API_URL=

# Phone number shown in the booking modal for completing payment
# by phone (until online payments are live).
VITE_CONTACT_PHONE="+91 99163 78416"

# Email/password sign-in & sign-up (with emailed verification codes).
# Leave false until email delivery (Resend) is set up; set to true and
# rebuild to show the forms again.
VITE_ENABLE_EMAIL_AUTH=false
